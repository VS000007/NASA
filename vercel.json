{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "$comment": "QUANTA_CAT Space Archaeologists Vercel Configuration",
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/credits",
      "destination": "/credits.html"
    },
    {
      "source": "/((?!api/|css/|js/|models/|data/|images/|story/|assets/|favicon|credits|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
